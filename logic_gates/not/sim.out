#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x64a3db749900 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x64a3db749a90 .scope module, "notgatetb" "notgatetb" 3 3;
 .timescale -9 -12;
v0x64a3db759cb0_0 .var "a", 0 0;
v0x64a3db759d50_0 .net "y", 0 0, L_0x64a3db759e20;  1 drivers
S_0x64a3db710500 .scope module, "dut" "notgate" 3 8, 4 1 0, S_0x64a3db749a90;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x64a3db759e20 .functor NOT 1, v0x64a3db759cb0_0, C4<0>, C4<0>, C4<0>;
v0x64a3db7106e0_0 .net "a", 0 0, v0x64a3db759cb0_0;  1 drivers
v0x64a3db759b90_0 .net "y", 0 0, L_0x64a3db759e20;  alias, 1 drivers
    .scope S_0x64a3db749a90;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "notgate.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64a3db749a90 {0 0 0};
    %vpi_call/w 3 16 "$monitor", "a=%b | y=%b", v0x64a3db759cb0_0, v0x64a3db759d50_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x64a3db759cb0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x64a3db759cb0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "notgatetb.v";
    "notgate.v";

#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60316661f520 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x603166632940 .scope module, "andgate_tb" "andgate_tb" 3 3;
 .timescale -9 -12;
v0x603166644c70_0 .var "a", 0 0;
v0x603166644d40_0 .var "b", 0 0;
v0x603166644e10_0 .net "y", 0 0, L_0x603166644f10;  1 drivers
S_0x603166632ad0 .scope module, "dut" "and_gate" 3 8, 4 1 0, S_0x603166632940;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x603166644f10 .functor AND 1, v0x603166644c70_0, v0x603166644d40_0, C4<1>, C4<1>;
v0x6031665f9550_0 .net "a", 0 0, v0x603166644c70_0;  1 drivers
v0x603166644a90_0 .net "b", 0 0, v0x603166644d40_0;  1 drivers
v0x603166644b50_0 .net "y", 0 0, L_0x603166644f10;  alias, 1 drivers
    .scope S_0x603166632940;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "and_gate.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x603166632940 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "a=%b b=%b y=%b", v0x603166644c70_0, v0x603166644d40_0, v0x603166644e10_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x603166644c70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x603166644d40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x603166644c70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x603166644d40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x603166644c70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x603166644d40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x603166644c70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x603166644d40_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "andgate_tb.v";
    "andgate.v";

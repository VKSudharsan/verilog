:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60cfec766980 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x60cfec766b10 .scope module, "exnortb" "exnortb" 3 3;
 .timescale -9 -12;
v0x60cfec779390_0 .var "a", 0 0;
v0x60cfec779460_0 .var "b", 0 0;
v0x60cfec779530_0 .net "y", 0 0, L_0x60cfec779770;  1 drivers
S_0x60cfec72d500 .scope module, "uut" "exnorgate" 3 8, 4 1 0, S_0x60cfec766b10;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x60cfec779630 .functor XOR 1, v0x60cfec779390_0, v0x60cfec779460_0, C4<0>, C4<0>;
L_0x60cfec779770 .functor NOT 1, L_0x60cfec779630, C4<0>, C4<0>, C4<0>;
v0x60cfec72d730_0 .net *"_ivl_0", 0 0, L_0x60cfec779630;  1 drivers
v0x60cfec7790f0_0 .net "a", 0 0, v0x60cfec779390_0;  1 drivers
v0x60cfec7791b0_0 .net "b", 0 0, v0x60cfec779460_0;  1 drivers
v0x60cfec779250_0 .net "y", 0 0, L_0x60cfec779770;  alias, 1 drivers
    .scope S_0x60cfec766b10;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "exnor_gate.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x60cfec766b10 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "a=%b b=%b | y=%b", v0x60cfec779390_0, v0x60cfec779460_0, v0x60cfec779530_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60cfec779390_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60cfec779460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60cfec779390_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60cfec779460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60cfec779390_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60cfec779460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60cfec779390_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60cfec779460_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;

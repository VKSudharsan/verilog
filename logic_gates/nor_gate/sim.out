#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5bea4c0c4980 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5bea4c0c4b10 .scope module, "nortb" "nortb" 3 3;
 .timescale -9 -12;
v0x5bea4c0d72d0_0 .var "a", 0 0;
v0x5bea4c0d73a0_0 .var "b", 0 0;
v0x5bea4c0d7470_0 .net "y", 0 0, L_0x5bea4c0d76b0;  1 drivers
S_0x5bea4c08b500 .scope module, "dut" "norgate" 3 8, 4 1 0, S_0x5bea4c0c4b10;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5bea4c0d7570 .functor OR 1, v0x5bea4c0d72d0_0, v0x5bea4c0d73a0_0, C4<0>, C4<0>;
L_0x5bea4c0d76b0 .functor NOT 1, L_0x5bea4c0d7570, C4<0>, C4<0>, C4<0>;
v0x5bea4c08b730_0 .net *"_ivl_0", 0 0, L_0x5bea4c0d7570;  1 drivers
v0x5bea4c0d7030_0 .net "a", 0 0, v0x5bea4c0d72d0_0;  1 drivers
v0x5bea4c0d70f0_0 .net "b", 0 0, v0x5bea4c0d73a0_0;  1 drivers
v0x5bea4c0d7190_0 .net "y", 0 0, L_0x5bea4c0d76b0;  alias, 1 drivers
    .scope S_0x5bea4c0c4b10;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "norgate.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5bea4c0c4b10 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "a=%b b=%b | y=%b", v0x5bea4c0d72d0_0, v0x5bea4c0d73a0_0, v0x5bea4c0d7470_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5bea4c0d72d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5bea4c0d73a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5bea4c0d72d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5bea4c0d73a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5bea4c0d72d0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5bea4c0d73a0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5bea4c0d72d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5bea4c0d73a0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "nortb.v";
    "norgate.v";

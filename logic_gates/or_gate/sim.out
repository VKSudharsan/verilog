#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5e7d7c04d940 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5e7d7c04dad0 .scope module, "orgate_tb" "orgate_tb" 3 3;
 .timescale -9 -12;
v0x5e7d7c05fd70_0 .var "a", 0 0;
v0x5e7d7c05fe40_0 .var "b", 0 0;
v0x5e7d7c05ff10_0 .net "y", 0 0, L_0x5e7d7c060010;  1 drivers
S_0x5e7d7c014500 .scope module, "dut" "or_gate" 3 8, 4 1 0, S_0x5e7d7c04dad0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5e7d7c060010 .functor OR 1, v0x5e7d7c05fd70_0, v0x5e7d7c05fe40_0, C4<0>, C4<0>;
v0x5e7d7c014730_0 .net "a", 0 0, v0x5e7d7c05fd70_0;  1 drivers
v0x5e7d7c05fb90_0 .net "b", 0 0, v0x5e7d7c05fe40_0;  1 drivers
v0x5e7d7c05fc50_0 .net "y", 0 0, L_0x5e7d7c060010;  alias, 1 drivers
    .scope S_0x5e7d7c04dad0;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "orgate.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5e7d7c04dad0 {0 0 0};
    %vpi_call/w 3 16 "$monitor", "a=%b b=%b y=%b", v0x5e7d7c05fd70_0, v0x5e7d7c05fe40_0, v0x5e7d7c05ff10_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e7d7c05fd70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e7d7c05fe40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e7d7c05fd70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e7d7c05fe40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e7d7c05fd70_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e7d7c05fe40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e7d7c05fd70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5e7d7c05fe40_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 21 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "orgate_tb.v";
    "orgate.v";

#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x57270feaf940 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x57270feafad0 .scope module, "exortb" "exortb" 3 3;
 .timescale -9 -12;
v0x57270fec1eb0_0 .var "a", 0 0;
v0x57270fec1f80_0 .var "b", 0 0;
v0x57270fec2050_0 .net "y", 0 0, L_0x57270fec2150;  1 drivers
S_0x57270fe76500 .scope module, "dut" "exorgate" 3 8, 4 1 0, S_0x57270feafad0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x57270fec2150 .functor XOR 1, v0x57270fec1eb0_0, v0x57270fec1f80_0, C4<0>, C4<0>;
v0x57270fe76730_0 .net "a", 0 0, v0x57270fec1eb0_0;  1 drivers
v0x57270fec1cd0_0 .net "b", 0 0, v0x57270fec1f80_0;  1 drivers
v0x57270fec1d90_0 .net "y", 0 0, L_0x57270fec2150;  alias, 1 drivers
    .scope S_0x57270feafad0;
T_0 ;
    %vpi_call/w 3 15 "$dumpfile", "exor_gate.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x57270feafad0 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "a=%b b=%b | y=%b", v0x57270fec1eb0_0, v0x57270fec1f80_0, v0x57270fec2050_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57270fec1eb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57270fec1f80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57270fec1eb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57270fec1f80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57270fec1eb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x57270fec1f80_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57270fec1eb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x57270fec1f80_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "exortb.v";
    "exor.v";

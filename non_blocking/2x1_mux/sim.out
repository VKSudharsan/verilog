#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x643c1c24a100 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x643c1c24a290 .scope module, "tb_mux2x1_nonblock" "tb_mux2x1_nonblock" 3 2;
 .timescale 0 0;
v0x643c1c25e300_0 .var "a", 0 0;
v0x643c1c25e3c0_0 .var "b", 0 0;
v0x643c1c25e490_0 .var/i "i", 31 0;
v0x643c1c25e560_0 .var "sel", 0 0;
v0x643c1c25e630_0 .net "y", 0 0, v0x643c1c25e190_0;  1 drivers
S_0x643c1c210500 .scope module, "uut" "mux2x1_nonblock" 3 8, 4 2 0, S_0x643c1c24a290;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
v0x643c1c210750_0 .net "a", 0 0, v0x643c1c25e300_0;  1 drivers
v0x643c1c25e000_0 .net "b", 0 0, v0x643c1c25e3c0_0;  1 drivers
v0x643c1c25e0c0_0 .net "sel", 0 0, v0x643c1c25e560_0;  1 drivers
v0x643c1c25e190_0 .var "y", 0 0;
E_0x643c1c24abc0 .event anyedge, v0x643c1c25e0c0_0, v0x643c1c210750_0, v0x643c1c25e000_0;
    .scope S_0x643c1c210500;
T_0 ;
    %wait E_0x643c1c24abc0;
    %load/vec4 v0x643c1c25e0c0_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v0x643c1c210750_0;
    %assign/vec4 v0x643c1c25e190_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x643c1c25e000_0;
    %assign/vec4 v0x643c1c25e190_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x643c1c24a290;
T_1 ;
    %vpi_call/w 3 16 "$dumpfile", "mux2x1_nonblock.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x643c1c24a290 {0 0 0};
    %vpi_call/w 3 19 "$monitor", "Time=%0t a=%b b=%b sel=%b y=%b", $time, v0x643c1c25e300_0, v0x643c1c25e3c0_0, v0x643c1c25e560_0, v0x643c1c25e630_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x643c1c25e490_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x643c1c25e490_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x643c1c25e490_0;
    %pad/s 3;
    %split/vec4 1;
    %store/vec4 v0x643c1c25e560_0, 0, 1;
    %split/vec4 1;
    %store/vec4 v0x643c1c25e3c0_0, 0, 1;
    %store/vec4 v0x643c1c25e300_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x643c1c25e490_0;
    %addi 1, 0, 32;
    %store/vec4 v0x643c1c25e490_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 27 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "muxtb.v";
    "mux.v";

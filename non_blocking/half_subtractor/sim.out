    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58ae463d2330 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "Time=%0t a=%b b=%b diff=%b borrow=%b", $time, v0x58ae463e6530_0, v0x58ae463e65f0_0, v0x58ae463e67c0_0, v0x58ae463e66c0_0 {0 0 0};

:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x6046a8a987e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x6046a8a98970 .scope module, "tb_full_subtractor_nonblock" "tb_full_subtractor_nonblock" 3 2;
 .timescale 0 0;
v0x6046a8aad3d0_0 .var "a", 0 0;
v0x6046a8aad490_0 .var "b", 0 0;
v0x6046a8aad530_0 .var "bin", 0 0;
v0x6046a8aad630_0 .net "bout", 0 0, v0x6046a8aad160_0;  1 drivers
v0x6046a8aad700_0 .net "diff", 0 0, v0x6046a8aad220_0;  1 drivers
v0x6046a8aad7f0_0 .var/i "i", 31 0;
S_0x6046a8a5e500 .scope module, "dut" "full_subtractor_nonblock" 3 8, 4 2 0, S_0x6046a8a98970;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "bin";
    .port_info 3 /OUTPUT 1 "diff";
    .port_info 4 /OUTPUT 1 "bout";
v0x6046a8a5e710_0 .net "a", 0 0, v0x6046a8aad3d0_0;  1 drivers
v0x6046a8aad000_0 .net "b", 0 0, v0x6046a8aad490_0;  1 drivers
v0x6046a8aad0c0_0 .net "bin", 0 0, v0x6046a8aad530_0;  1 drivers
v0x6046a8aad160_0 .var "bout", 0 0;
v0x6046a8aad220_0 .var "diff", 0 0;
E_0x6046a8a99000 .event anyedge, v0x6046a8a5e710_0, v0x6046a8aad000_0, v0x6046a8aad0c0_0;
    .scope S_0x6046a8a5e500;
T_0 ;
    %wait E_0x6046a8a99000;
    %load/vec4 v0x6046a8a5e710_0;
    %load/vec4 v0x6046a8aad000_0;
    %xor;
    %load/vec4 v0x6046a8aad0c0_0;
    %xor;
    %assign/vec4 v0x6046a8aad220_0, 0;
    %load/vec4 v0x6046a8a5e710_0;
    %inv;
    %load/vec4 v0x6046a8aad000_0;
    %and;
    %load/vec4 v0x6046a8a5e710_0;
    %load/vec4 v0x6046a8aad000_0;
    %xor;
    %inv;
    %load/vec4 v0x6046a8aad0c0_0;
    %and;
    %or;
    %assign/vec4 v0x6046a8aad160_0, 0;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x6046a8a98970;
T_1 ;
    %vpi_call/w 3 17 "$dumpfile", "full_subtractor_nonblock.vcd" {0 0 0};
    %vpi_call/w 3 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6046a8a98970 {0 0 0};
    %vpi_call/w 3 20 "$monitor", "Time=%0t a=%b b=%b bin=%b diff=%b bout=%b", $time, v0x6046a8aad3d0_0, v0x6046a8aad490_0, v0x6046a8aad530_0, v0x6046a8aad700_0, v0x6046a8aad630_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x6046a8aad7f0_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x6046a8aad7f0_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x6046a8aad7f0_0;
    %pad/s 3;
    %split/vec4 1;
    %store/vec4 v0x6046a8aad530_0, 0, 1;
    %split/vec4 1;
    %store/vec4 v0x6046a8aad490_0, 0, 1;
    %store/vec4 v0x6046a8aad3d0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x6046a8aad7f0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x6046a8aad7f0_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 28 "$finish" {0 0 0};
    %end;
    .thread T_1;

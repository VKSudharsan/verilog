#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x60fbfcb55150 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x60fbfcb552e0 .scope module, "tb_halfadder" "tb_halfadder" 3 1;
 .timescale 0 0;
v0x60fbfcb69070_0 .var "a", 0 0;
v0x60fbfcb69130_0 .var "b", 0 0;
v0x60fbfcb69200_0 .net "carry", 0 0, v0x60fbfcb68e30_0;  1 drivers
v0x60fbfcb69300_0 .net "sum", 0 0, v0x60fbfcb68f00_0;  1 drivers
S_0x60fbfcb1b500 .scope module, "dut" "halfadder" 3 4, 4 1 0, S_0x60fbfcb552e0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
v0x60fbfcb1b750_0 .net "a", 0 0, v0x60fbfcb69070_0;  1 drivers
v0x60fbfcb68d70_0 .net "b", 0 0, v0x60fbfcb69130_0;  1 drivers
v0x60fbfcb68e30_0 .var "carry", 0 0;
v0x60fbfcb68f00_0 .var "sum", 0 0;
E_0x60fbfcb55a30 .event anyedge, v0x60fbfcb1b750_0, v0x60fbfcb68d70_0;
    .scope S_0x60fbfcb1b500;
T_0 ;
    %wait E_0x60fbfcb55a30;
    %load/vec4 v0x60fbfcb1b750_0;
    %load/vec4 v0x60fbfcb68d70_0;
    %xor;
    %store/vec4 v0x60fbfcb68f00_0, 0, 1;
    %load/vec4 v0x60fbfcb1b750_0;
    %load/vec4 v0x60fbfcb68d70_0;
    %and;
    %store/vec4 v0x60fbfcb68e30_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x60fbfcb552e0;
T_1 ;
    %vpi_call/w 3 11 "$dumpfile", "halfadder.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x60fbfcb552e0 {0 0 0};
    %vpi_call/w 3 13 "$monitor", "Time=%0t a=%b b=%b sum=%b carry=%b", $time, v0x60fbfcb69070_0, v0x60fbfcb69130_0, v0x60fbfcb69300_0, v0x60fbfcb69200_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60fbfcb69070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60fbfcb69130_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60fbfcb69070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60fbfcb69130_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60fbfcb69070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x60fbfcb69130_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60fbfcb69070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x60fbfcb69130_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "halfaddertb.v";
    "halfadder.v";

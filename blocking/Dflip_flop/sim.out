#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5efa70857ca0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5efa70857e30 .scope module, "tb_dff_block" "tb_dff_block" 3 2;
 .timescale 0 0;
v0x5efa7086b440_0 .var "clk", 0 0;
v0x5efa7086b510_0 .var "d", 0 0;
v0x5efa7086b5e0_0 .net "q", 0 0, v0x5efa7086b320_0;  1 drivers
S_0x5efa7081e500 .scope module, "dut" "dff_block" 3 7, 4 2 0, S_0x5efa70857e30;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "d";
    .port_info 2 /OUTPUT 1 "q";
v0x5efa7081e730_0 .net "clk", 0 0, v0x5efa7086b440_0;  1 drivers
v0x5efa7086b260_0 .net "d", 0 0, v0x5efa7086b510_0;  1 drivers
v0x5efa7086b320_0 .var "q", 0 0;
E_0x5efa708583f0 .event posedge, v0x5efa7081e730_0;
    .scope S_0x5efa7081e500;
T_0 ;
    %wait E_0x5efa708583f0;
    %load/vec4 v0x5efa7086b260_0;
    %store/vec4 v0x5efa7086b320_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5efa70857e30;
T_1 ;
    %vpi_call/w 3 14 "$dumpfile", "dff_block.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5efa70857e30 {0 0 0};
    %vpi_call/w 3 17 "$monitor", "Time=%0t clk=%b d=%b q=%b", $time, v0x5efa7086b440_0, v0x5efa7086b510_0, v0x5efa7086b5e0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efa7086b440_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efa7086b510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5efa7086b510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efa7086b510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5efa7086b510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5efa7086b510_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 28 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x5efa70857e30;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x5efa7086b440_0;
    %inv;
    %store/vec4 v0x5efa7086b440_0, 0, 1;
    %jmp T_2;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "fftb.v";
    "ff.v";

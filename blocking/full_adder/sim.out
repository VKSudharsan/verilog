    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x591117a3c9b0;
T_1 ;
    %vpi_call/w 3 17 "$dumpfile", "full_adder_block.vcd" {0 0 0};
    %vpi_call/w 3 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x591117a3c9b0 {0 0 0};
    %vpi_call/w 3 20 "$monitor", "Time=%0t a=%b b=%b cin=%b sum=%b cout=%b", $time, v0x591117a511c0_0, v0x591117a51280_0, v0x591117a51320_0, v0x591117a515e0_0, v0x591117a51420_0 {0 0 0};

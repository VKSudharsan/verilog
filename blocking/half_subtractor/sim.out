#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x606d391e8190 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x606d391e8320 .scope module, "tb_half_subtractor_block" "tb_half_subtractor_block" 3 2;
 .timescale 0 0;
v0x606d391fc450_0 .var "a", 0 0;
v0x606d391fc510_0 .var "b", 0 0;
v0x606d391fc5e0_0 .net "borrow", 0 0, v0x606d391fc210_0;  1 drivers
v0x606d391fc6e0_0 .net "diff", 0 0, v0x606d391fc2e0_0;  1 drivers
S_0x606d391ae500 .scope module, "dut" "half_subtractor_block" 3 7, 4 2 0, S_0x606d391e8320;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "diff";
    .port_info 3 /OUTPUT 1 "borrow";
v0x606d391ae750_0 .net "a", 0 0, v0x606d391fc450_0;  1 drivers
v0x606d391fc150_0 .net "b", 0 0, v0x606d391fc510_0;  1 drivers
v0x606d391fc210_0 .var "borrow", 0 0;
v0x606d391fc2e0_0 .var "diff", 0 0;
E_0x606d391e8cd0 .event anyedge, v0x606d391ae750_0, v0x606d391fc150_0;
    .scope S_0x606d391ae500;
T_0 ;
    %wait E_0x606d391e8cd0;
    %load/vec4 v0x606d391ae750_0;
    %load/vec4 v0x606d391fc150_0;
    %xor;
    %store/vec4 v0x606d391fc2e0_0, 0, 1;
    %load/vec4 v0x606d391ae750_0;
    %inv;
    %load/vec4 v0x606d391fc150_0;
    %and;
    %store/vec4 v0x606d391fc210_0, 0, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x606d391e8320;
T_1 ;
    %vpi_call/w 3 15 "$dumpfile", "half_subtractor_block.vcd" {0 0 0};
    %vpi_call/w 3 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x606d391e8320 {0 0 0};
    %vpi_call/w 3 18 "$monitor", "Time=%0t a=%b b=%b diff=%b borrow=%b", $time, v0x606d391fc450_0, v0x606d391fc510_0, v0x606d391fc6e0_0, v0x606d391fc5e0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x606d391fc450_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x606d391fc510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x606d391fc450_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x606d391fc510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x606d391fc450_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x606d391fc510_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x606d391fc450_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x606d391fc510_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 26 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "halfsubtb.v";
    "halfsub.v";
